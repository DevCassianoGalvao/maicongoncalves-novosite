# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Site do Vereador Maicon Gonçalves
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Se o site ficar numa subpasta, ajuste: RewriteBase /subpasta/
  RewriteBase /

  # Forçar HTTPS (descomente quando o SSL estiver ativo)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pastas e arquivos internos nunca ficam acessíveis pela web
  RewriteRule ^(app|storage|site|tools|content)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(README\.md|vercel\.json|package(-lock)?\.json|composer\.(json|lock))$ - [F,L]
  RewriteRule ^install/(schema\.sql|seed\.json)$ - [F,L]

  # Resto do WordPress antigo: não existe mais (410 Gone)
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-content|wp-includes|wp-json|wp-cron\.php|wp-config\.php|wp-trackback\.php|wp-comments-post\.php)(/|$) - [G,L]

  # Endereço sem barra no final -> mesmo endereço com barra (301), igual ao canonical
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

  # Todo o resto que não for arquivo ou pasta real vai para o roteador (index.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Logs, backups e arquivos de configuração soltos nunca são servidos
<FilesMatch "(^error_log$|\.(sql|log|bak|old|orig|swp|yml|yaml|ini|sh|md)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^\.(env|git)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
