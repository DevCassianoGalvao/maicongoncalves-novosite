# Só imagens enviadas pelo painel. Nada aqui pode ser executado.
Options -Indexes -ExecCGI
<FilesMatch "\.(php\d?|phtml|phar|pht|pl|py|cgi|sh|shtml|html?|js|svg)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
