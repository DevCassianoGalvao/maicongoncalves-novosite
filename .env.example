# =====================================================================
#  Copie este arquivo para ".env" e preencha.
#  Onde colocar o .env: de preferência UM NÍVEL ACIMA da pasta pública
#  (ex.: /home/usuario/.env quando o site está em /home/usuario/public_html).
#  Também funciona na raiz do site; o .htaccess bloqueia o acesso pela web.
# =====================================================================

# ----- Site -----
APP_URL=https://maicongoncalves.com.br
# Só preencha se o site ficar numa subpasta (ex.: /novo). Na raiz do domínio, deixe vazio.
APP_BASE_PATH=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# ----- Banco de dados (cPanel > Bancos de dados MySQL) -----
# No cPanel o nome do banco e do usuário levam o prefixo da conta, ex.: conta_site
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ----- Formulário de contato: envio pelo Brevo -----
# Brevo > SMTP & API > Chaves de API > Gerar nova chave (começa com xkeysib-)
BREVO_API_KEY=
# Remetente: precisa estar validado no Brevo (Remetentes, domínios e IPs dedicados)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Site Vereador Maicon Gonçalves"
# Quem recebe os contatos do site
MAIL_TO=vereadormaicongoncalves@gmail.com
MAIL_TO_NAME="Vereador Maicon Gonçalves"
# Assunto do e-mail que chega para o gabinete
# Cópia oculta (opcional). Vários e-mails separados por vírgula.
MAIL_BCC=

# ----- Localização ("Usar minha localização atual") -----
# Endereço aproximado vem do OpenStreetMap (Nominatim), gratuito e sem chave.
# A política de uso pede um e-mail de contato nas consultas:
GEO_CONTACT_EMAIL=vereadormaicongoncalves@gmail.com
